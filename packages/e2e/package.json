{
  "name": "@vswap/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end test suite that drives @vswap/cli against two containerised @vswap/agent instances with a mock Solana admin RPC validator.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:real": "bash -c 'VSWAP_E2E_PROFILE=real vitest run'",
    "test:real:happy": "bash -c 'VSWAP_E2E_PROFILE=real vitest run src/scenarios/happy-path.test.ts'",
    "test:real:tower-pubkey-mismatch": "bash -c 'VSWAP_E2E_PROFILE=real vitest run src/scenarios/tower-pubkey-mismatch.test.ts'",
    "env:up": "bash ../../scripts/test-env/up.sh",
    "env:up:real": "bash ../../scripts/test-env/up-real.sh",
    "env:down": "bash ../../scripts/test-env/down.sh",
    "env:down:real": "bash ../../scripts/test-env/down-real.sh",
    "gen-fixtures": "node scripts/gen-fixtures.mjs",
    "gen-fixtures:force": "node scripts/gen-fixtures.mjs --force"
  },
  "dependencies": {
    "@vswap/cli": "workspace:*",
    "@vswap/protocol": "workspace:*",
    "execa": "^9.5.1",
    "libsodium-wrappers": "0.7.15",
    "node-forge": "^1.3.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20.14.0",
    "@types/node-forge": "^1.3.11",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "typescript": "5.5.4",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
